# ============================================================
# CLASSVAULT ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi Anda
# ============================================================

APP_NAME=ClassVault
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/classvault/public

# Database Configuration (XAMPP Default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=classvault_db
DB_USER=root
DB_PASS=

# Upload Configuration (Maks 10MB)
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx,xlsx,pptx,txt,jpg,jpeg,png

# Session & Security
SESSION_LIFETIME=7200
SECURE_COOKIES=false
